rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOfficialDeveloperAuth() {
      return request.auth != null &&
             request.auth.token.keys().hasAny(['email']) &&
             request.auth.token.email is string &&
             request.auth.token.email.lower() == 'albertomiller747@gmail.com';
    }

    function allowedProfileKeys() {
      return [
        'userId',
        'displayName',
        'username',
        'countryCode',
        'countryName',
        'email',
        'photoUrl',
        'bannerUrl',
        'gamerscore',
        'dateOfBirth',
        'bio',
        'selectedTags',
        'isVerifiedDeveloper',
        'mostPlayedGameName',
        'mostPlayedGamePkg',
        'mostPlayedMinutes',
        'totalPlayTimeMinutes',
        'totalSessionsCount',
        'themeMode',
        'customBgColor',
        'reducedAnimations',
        'autoBigScreenLandscape',
        'showControllerLegendBar',
        'suppressActivationWarning',
        'selectedBoostMode',
        'appliedOptionIds',
        'hudEnabled',
        'hudFpsMode',
        'hudTargetCap',
        'hudPosition',
        'hudScalePct',
        'hudOpacityPct',
        'hudShowFps',
        'hudShowTemp',
        'hudShowBattery',
        'hudShowTime',
        'hudShowRamPct',
        'hudShowClock',
        'crosshairEnabled',
        'crosshairType',
        'crosshairColorArgb',
        'crosshairSizeDp',
        'lightbarColorHex',
        'recResolutionLabel',
        'recFps',
        'recBitrateMbps',
        'recMicEnabled',
        'recShowTimerHud',
        'recOverlayEnabled',
        'recBubbleSizeDp',
        'targetGamePkg',
        'targetGameName',
        'libraryPackages',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidUserCloudProfile(data, targetUserId) {
      return data.userId == targetUserId &&
             (request.auth.uid == targetUserId || isOfficialDeveloperAuth()) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.username is string && data.username.size() <= 30 &&
             data.countryCode is string && data.countryCode.size() <= 10 &&
             data.countryName is string && data.countryName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.photoUrl is string && data.photoUrl.size() <= 1000 &&
             data.bannerUrl is string && data.bannerUrl.size() <= 1000 &&
             data.gamerscore is int && data.gamerscore >= 0 &&
             data.dateOfBirth is string && data.dateOfBirth.size() <= 40 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.selectedTags is list && data.selectedTags.size() <= 4 &&
             data.isVerifiedDeveloper is bool &&
             (data.isVerifiedDeveloper == false || isOfficialDeveloperAuth()) &&
             data.mostPlayedGameName is string && data.mostPlayedGameName.size() <= 120 &&
             data.mostPlayedGamePkg is string && data.mostPlayedGamePkg.size() <= 150 &&
             data.mostPlayedMinutes is int && data.mostPlayedMinutes >= 0 &&
             data.totalPlayTimeMinutes is int && data.totalPlayTimeMinutes >= 0 &&
             data.totalSessionsCount is int && data.totalSessionsCount >= 0 &&
             data.themeMode is string && data.themeMode.size() <= 40 &&
             data.customBgColor is int &&
             data.reducedAnimations is bool &&
             data.autoBigScreenLandscape is bool &&
             data.showControllerLegendBar is bool &&
             data.suppressActivationWarning is bool &&
             data.selectedBoostMode is string && data.selectedBoostMode.size() <= 30 &&
             data.appliedOptionIds is list && data.appliedOptionIds.size() <= 50 &&
             data.hudEnabled is bool &&
             data.hudFpsMode is string && data.hudFpsMode.size() <= 30 &&
             data.hudTargetCap is string && data.hudTargetCap.size() <= 20 &&
             data.hudPosition is string && data.hudPosition.size() <= 30 &&
             data.hudScalePct is int &&
             data.hudOpacityPct is int &&
             data.hudShowFps is bool &&
             data.hudShowTemp is bool &&
             data.hudShowBattery is bool &&
             data.hudShowTime is bool &&
             data.hudShowRamPct is bool &&
             data.hudShowClock is bool &&
             data.crosshairEnabled is bool &&
             data.crosshairType is string && data.crosshairType.size() <= 30 &&
             data.crosshairColorArgb is int &&
             data.crosshairSizeDp is int &&
             data.lightbarColorHex is string && data.lightbarColorHex.size() <= 20 &&
             data.recResolutionLabel is string && data.recResolutionLabel.size() <= 20 &&
             data.recFps is int &&
             data.recBitrateMbps is int &&
             data.recMicEnabled is bool &&
             data.recShowTimerHud is bool &&
             data.recOverlayEnabled is bool &&
             data.recBubbleSizeDp is int &&
             data.targetGamePkg is string && data.targetGamePkg.size() <= 150 &&
             data.targetGameName is string && data.targetGameName.size() <= 120 &&
             data.libraryPackages is list && data.libraryPackages.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isOfficialDeveloperAuth());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isOfficialDeveloperAuth());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isOfficialDeveloperAuth()) &&
                       incoming().keys().hasAll(allowedProfileKeys()) &&
                       incoming().keys().hasOnly(allowedProfileKeys()) &&
                       isValidUserCloudProfile(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isOfficialDeveloperAuth()) &&
                       isValidUserCloudProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'username',
                         'countryCode',
                         'countryName',
                         'email',
                         'photoUrl',
                         'bannerUrl',
                         'gamerscore',
                         'dateOfBirth',
                         'bio',
                         'selectedTags',
                         'isVerifiedDeveloper',
                         'mostPlayedGameName',
                         'mostPlayedGamePkg',
                         'mostPlayedMinutes',
                         'totalPlayTimeMinutes',
                         'totalSessionsCount',
                         'themeMode',
                         'customBgColor',
                         'reducedAnimations',
                         'autoBigScreenLandscape',
                         'showControllerLegendBar',
                         'suppressActivationWarning',
                         'selectedBoostMode',
                         'appliedOptionIds',
                         'hudEnabled',
                         'hudFpsMode',
                         'hudTargetCap',
                         'hudPosition',
                         'hudScalePct',
                         'hudOpacityPct',
                         'hudShowFps',
                         'hudShowTemp',
                         'hudShowBattery',
                         'hudShowTime',
                         'hudShowRamPct',
                         'hudShowClock',
                         'crosshairEnabled',
                         'crosshairType',
                         'crosshairColorArgb',
                         'crosshairSizeDp',
                         'lightbarColorHex',
                         'recResolutionLabel',
                         'recFps',
                         'recBitrateMbps',
                         'recMicEnabled',
                         'recShowTimerHud',
                         'recOverlayEnabled',
                         'recBubbleSizeDp',
                         'targetGamePkg',
                         'targetGameName',
                         'libraryPackages',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isOfficialDeveloperAuth());
    }

    function requiredUsernameClaimKeys() {
      return ['userId', 'username', 'updatedAt'];
    }

    function allowedUsernameClaimKeys() {
      return [
        'userId',
        'username',
        'displayName',
        'bio',
        'photoUrl',
        'bannerUrl',
        'countryCode',
        'countryName',
        'gamerscore',
        'mostPlayedGameName',
        'mostPlayedMinutes',
        'totalPlayTimeMinutes',
        'selectedTags',
        'isVerifiedDeveloper',
        'updatedAt'
      ];
    }

    function isValidUsernameClaim(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             (data.userId == request.auth.uid || isOfficialDeveloperAuth()) &&
             data.username is string &&
             data.username.size() >= 3 &&
             data.username.size() <= 20 &&
             data.username.matches('^[a-zA-Z0-9_]+$') &&
             (data.username.lower() != 'albertomiller747' || isOfficialDeveloperAuth()) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 1000)) &&
             (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 10)) &&
             (!('countryName' in data) || (data.countryName is string && data.countryName.size() <= 100)) &&
             (!('gamerscore' in data) || (data.gamerscore is int && data.gamerscore >= 0)) &&
             (!('mostPlayedGameName' in data) || (data.mostPlayedGameName is string && data.mostPlayedGameName.size() <= 120)) &&
             (!('mostPlayedMinutes' in data) || (data.mostPlayedMinutes is int && data.mostPlayedMinutes >= 0)) &&
             (!('totalPlayTimeMinutes' in data) || (data.totalPlayTimeMinutes is int && data.totalPlayTimeMinutes >= 0)) &&
             (!('selectedTags' in data) || (data.selectedTags is list && data.selectedTags.size() <= 4)) &&
             (!('isVerifiedDeveloper' in data) || (data.isVerifiedDeveloper is bool && (data.isVerifiedDeveloper == false || isOfficialDeveloperAuth()))) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /usernames/{usernameLower} {
      allow get: if isSignedIn() && isValidId(usernameLower);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(usernameLower) &&
                       incoming().keys().hasAll(requiredUsernameClaimKeys()) &&
                       incoming().keys().hasOnly(allowedUsernameClaimKeys()) &&
                       isValidUsernameClaim(incoming()) &&
                       incoming().username.lower() == usernameLower;

      allow update: if isSignedIn() &&
                       isValidId(usernameLower) &&
                       incoming().keys().hasOnly(allowedUsernameClaimKeys()) &&
                       isValidUsernameClaim(incoming()) &&
                       (existing().userId == request.auth.uid || isOfficialDeveloperAuth()) &&
                       incoming().userId == existing().userId &&
                       incoming().username.lower() == usernameLower;

      allow delete: if isSignedIn() && isValidId(usernameLower) && (existing().userId == request.auth.uid || isOfficialDeveloperAuth());
    }

    function requiredTopGearProductKeys() {
      return [
        'id',
        'category',
        'group',
        'tier',
        'name',
        'benefit_line',
        'benefits',
        'price_level',
        'best_for',
        'trade_off',
        'affiliate_url',
        'merchant',
        'active',
        'last_updated'
      ];
    }

    function allowedTopGearProductKeys() {
      return [
        'id',
        'category',
        'group',
        'tier',
        'badge',
        'name',
        'image_url',
        'benefit_line',
        'benefits',
        'price_level',
        'best_for',
        'trade_off',
        'pairs_with',
        'affiliate_url',
        'merchant',
        'active',
        'last_updated'
      ];
    }

    function isValidTopGearProduct(data, productId) {
      return data.id is string &&
             data.id == productId &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.group is string && data.group.size() >= 1 && data.group.size() <= 80 &&
             data.tier is string && (data.tier == 'budget' || data.tier == 'value' || data.tier == 'premium') &&
             (!('badge' in data) || (data.badge is string && data.badge.size() <= 40)) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
             (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 1000)) &&
             data.benefit_line is string && data.benefit_line.size() >= 1 && data.benefit_line.size() <= 200 &&
             data.benefits is list && data.benefits.size() <= 3 &&
             data.price_level is string && (data.price_level == '$' || data.price_level == '$$' || data.price_level == '$$$') &&
             data.best_for is string && data.best_for.size() >= 1 && data.best_for.size() <= 240 &&
             data.trade_off is string && data.trade_off.size() >= 1 && data.trade_off.size() <= 240 &&
             (!('pairs_with' in data) || (data.pairs_with is string && data.pairs_with.size() <= 80)) &&
             data.affiliate_url is string && data.affiliate_url.size() >= 1 && data.affiliate_url.size() <= 500 &&
             data.merchant is string && data.merchant.size() >= 1 && data.merchant.size() <= 60 &&
             data.active is bool &&
             data.last_updated is string && data.last_updated.size() <= 40;
    }

    match /top_gear_products/{productId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOfficialDeveloperAuth() &&
                               isValidId(productId) &&
                               incoming().keys().hasAll(requiredTopGearProductKeys()) &&
                               incoming().keys().hasOnly(allowedTopGearProductKeys()) &&
                               isValidTopGearProduct(incoming(), productId);
      allow delete: if isOfficialDeveloperAuth() && isValidId(productId);
    }

    // --- DUAL-SIDED SQUAD REFERRAL LOOP RULES ---

    function requiredReferralCodeKeys() {
      return [
        'referrerUid',
        'referrerUsername',
        'referrerDisplayName',
        'code',
        'passesRemaining',
        'validatedCount',
        'updatedAt'
      ];
    }

    function allowedReferralCodeKeys() {
      return [
        'referrerUid',
        'referrerUsername',
        'referrerDisplayName',
        'referrerDeviceHash',
        'code',
        'passesRemaining',
        'validatedCount',
        'updatedAt'
      ];
    }

    function isValidReferralCodeEntry(data, code) {
      return data.referrerUid is string &&
             data.referrerUid.size() >= 1 &&
             data.referrerUid.size() <= 128 &&
             data.referrerUid == request.auth.uid &&
             data.referrerUsername is string &&
             data.referrerUsername.size() >= 1 &&
             data.referrerUsername.size() <= 40 &&
             data.referrerDisplayName is string &&
             data.referrerDisplayName.size() >= 1 &&
             data.referrerDisplayName.size() <= 100 &&
             (!('referrerDeviceHash' in data) || (data.referrerDeviceHash is string && data.referrerDeviceHash.size() <= 128)) &&
             data.code is string &&
             data.code == code &&
             data.code.size() >= 6 &&
             data.code.size() <= 30 &&
             data.code.matches('^GMAX-[A-Z0-9_\\-]{3,25}$') &&
             data.passesRemaining is int &&
             data.passesRemaining >= 0 &&
             data.passesRemaining <= 999 &&
             data.validatedCount is int &&
             data.validatedCount >= 0 &&
             data.validatedCount <= 100000 &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /referral_codes/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isSignedIn() && resource.data.referrerUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(code) &&
                       incoming().keys().hasAll(requiredReferralCodeKeys()) &&
                       incoming().keys().hasOnly(allowedReferralCodeKeys()) &&
                       isValidReferralCodeEntry(incoming(), code);

      allow update: if isSignedIn() &&
                       isValidId(code) &&
                       incoming().keys().hasOnly(allowedReferralCodeKeys()) &&
                       isValidReferralCodeEntry(incoming(), code) &&
                       existing().referrerUid == request.auth.uid &&
                       incoming().referrerUid == existing().referrerUid &&
                       incoming().code == existing().code &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'referrerUsername',
                         'referrerDisplayName',
                         'referrerDeviceHash',
                         'passesRemaining',
                         'validatedCount',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(code) && existing().referrerUid == request.auth.uid;
    }

    function requiredReferralActivationKeys() {
      return [
        'inviteeUid',
        'inviteeUsername',
        'inviteeDisplayName',
        'referrerUid',
        'referrerUsername',
        'referrerCode',
        'deviceFingerprintHash',
        'status',
        'boostedMinutesCompleted',
        'hudMatchCompleted',
        'activationTrigger',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidReferralActivation(data, inviteeUid) {
      return data.inviteeUid is string &&
             data.inviteeUid == inviteeUid &&
             data.inviteeUid == request.auth.uid &&
             data.inviteeUsername is string &&
             data.inviteeUsername.size() >= 1 &&
             data.inviteeUsername.size() <= 40 &&
             data.inviteeDisplayName is string &&
             data.inviteeDisplayName.size() >= 1 &&
             data.inviteeDisplayName.size() <= 100 &&
             data.referrerUid is string &&
             data.referrerUid.size() >= 1 &&
             data.referrerUid.size() <= 128 &&
             data.referrerUid != data.inviteeUid &&
             data.referrerUsername is string &&
             data.referrerUsername.size() >= 1 &&
             data.referrerUsername.size() <= 40 &&
             data.referrerCode is string &&
             data.referrerCode.size() >= 6 &&
             data.referrerCode.size() <= 30 &&
             data.referrerCode.matches('^GMAX-[A-Z0-9_\\-]{3,25}$') &&
             data.deviceFingerprintHash is string &&
             data.deviceFingerprintHash.size() >= 16 &&
             data.deviceFingerprintHash.size() <= 128 &&
             data.deviceFingerprintHash.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.status is string &&
             (data.status == 'PENDING_ACTIVATION' || data.status == 'ACTIVATED') &&
             data.boostedMinutesCompleted is int &&
             data.boostedMinutesCompleted >= 0 &&
             data.boostedMinutesCompleted <= 100000 &&
             data.hudMatchCompleted is bool &&
             data.activationTrigger is string &&
             data.activationTrigger.size() >= 1 &&
             data.activationTrigger.size() <= 60 &&
             (data.status == 'PENDING_ACTIVATION' || data.boostedMinutesCompleted >= 15 || data.hudMatchCompleted == true) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /referral_activations/{inviteeUid} {
      allow get: if isSignedIn() &&
                    isValidId(inviteeUid) &&
                    (request.auth.uid == inviteeUid || resource.data.referrerUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (resource.data.inviteeUid == request.auth.uid || resource.data.referrerUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(inviteeUid) &&
                       request.auth.uid == inviteeUid &&
                       incoming().keys().hasAll(requiredReferralActivationKeys()) &&
                       incoming().keys().hasOnly(requiredReferralActivationKeys()) &&
                       isValidReferralActivation(incoming(), inviteeUid) &&
                       incoming().status == 'PENDING_ACTIVATION';

      allow update: if isSignedIn() &&
                       isValidId(inviteeUid) &&
                       request.auth.uid == inviteeUid &&
                       isValidReferralActivation(incoming(), inviteeUid) &&
                       existing().inviteeUid == request.auth.uid &&
                       existing().status == 'PENDING_ACTIVATION' &&
                       incoming().inviteeUid == existing().inviteeUid &&
                       incoming().referrerUid == existing().referrerUid &&
                       incoming().referrerUsername == existing().referrerUsername &&
                       incoming().referrerCode == existing().referrerCode &&
                       incoming().deviceFingerprintHash == existing().deviceFingerprintHash &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'inviteeUsername',
                         'inviteeDisplayName',
                         'status',
                         'boostedMinutesCompleted',
                         'hudMatchCompleted',
                         'activationTrigger',
                         'updatedAt'
                       ]);

      allow delete: if false;
    }

    function requiredDeviceReferralClaimKeys() {
      return [
        'deviceFingerprintHash',
        'inviteeUid',
        'referrerUid',
        'referrerCode',
        'createdAt'
      ];
    }

    function isValidDeviceReferralClaim(data, deviceFingerprintHash) {
      return data.deviceFingerprintHash is string &&
             data.deviceFingerprintHash == deviceFingerprintHash &&
             data.deviceFingerprintHash.size() >= 16 &&
             data.deviceFingerprintHash.size() <= 128 &&
             data.deviceFingerprintHash.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.inviteeUid is string &&
             data.inviteeUid.size() >= 1 &&
             data.inviteeUid.size() <= 128 &&
             data.inviteeUid == request.auth.uid &&
             data.referrerUid is string &&
             data.referrerUid.size() >= 1 &&
             data.referrerUid.size() <= 128 &&
             data.referrerUid != data.inviteeUid &&
             data.referrerCode is string &&
             data.referrerCode.size() >= 6 &&
             data.referrerCode.size() <= 30 &&
             data.referrerCode.matches('^GMAX-[A-Z0-9_\\-]{3,25}$') &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /device_referral_claims/{deviceFingerprintHash} {
      allow get: if isSignedIn() && isValidId(deviceFingerprintHash);
      allow list: if isSignedIn() && resource.data.inviteeUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(deviceFingerprintHash) &&
                       incoming().keys().hasAll(requiredDeviceReferralClaimKeys()) &&
                       incoming().keys().hasOnly(requiredDeviceReferralClaimKeys()) &&
                       isValidDeviceReferralClaim(incoming(), deviceFingerprintHash);

      allow update, delete: if false;
    }

    // --- RIVALS REAL-TIME SQUAD COMPETITION RULES ---

    function requiredRivalsSquadKeys() {
      return [
        'squadId',
        'name',
        'bio',
        'squadCode',
        'leaderUid',
        'leaderUsername',
        'memberUids',
        'seasonMonthKey',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidRivalsSquad(data, squadId) {
      return data.squadId is string &&
             data.squadId == squadId &&
             data.squadId.size() >= 1 &&
             data.squadId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 40 &&
             data.bio is string &&
             data.bio.size() <= 150 &&
             data.squadCode is string &&
             data.squadCode.size() >= 8 &&
             data.squadCode.size() <= 32 &&
             data.squadCode.matches('^RIVALS-[A-Z0-9_\\-]{3,25}$') &&
             data.leaderUid is string &&
             data.leaderUid.size() >= 1 &&
             data.leaderUid.size() <= 128 &&
             data.leaderUsername is string &&
             data.leaderUsername.size() >= 1 &&
             data.leaderUsername.size() <= 40 &&
             data.memberUids is list &&
             data.memberUids.size() >= 1 &&
             data.memberUids.size() <= 5 &&
             data.memberUids[0] is string &&
             data.leaderUid in data.memberUids &&
             data.seasonMonthKey is string &&
             data.seasonMonthKey.size() == 7 &&
             data.seasonMonthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /rivals_squads/{squadId} {
      allow get: if isSignedIn() && isValidId(squadId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(squadId) &&
                       incoming().keys().hasAll(requiredRivalsSquadKeys()) &&
                       incoming().keys().hasOnly(requiredRivalsSquadKeys()) &&
                       isValidRivalsSquad(incoming(), squadId) &&
                       incoming().leaderUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(squadId) &&
                       incoming().keys().hasOnly(requiredRivalsSquadKeys()) &&
                       isValidRivalsSquad(incoming(), squadId) &&
                       incoming().squadId == existing().squadId &&
                       incoming().squadCode == existing().squadCode &&
                       incoming().leaderUid == existing().leaderUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Squad Leader updates squad name, 150-char bio, roster, or season key
                         (existing().leaderUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'name',
                            'bio',
                            'leaderUsername',
                            'memberUids',
                            'seasonMonthKey',
                            'updatedAt'
                          ])) ||
                         // Action 2: Player joins squad (up to 5 max) or member leaves squad
                         ((request.auth.uid in incoming().memberUids || request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'memberUids',
                            'seasonMonthKey',
                            'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(squadId) && existing().leaderUid == request.auth.uid;
    }

    function requiredRivalsSquadCodeKeys() {
      return [
        'squadCode',
        'squadId',
        'leaderUid',
        'squadName',
        'updatedAt'
      ];
    }

    function isValidRivalsSquadCode(data, squadCode) {
      return data.squadCode is string &&
             data.squadCode == squadCode &&
             data.squadCode.size() >= 8 &&
             data.squadCode.size() <= 32 &&
             data.squadCode.matches('^RIVALS-[A-Z0-9_\\-]{3,25}$') &&
             data.squadId is string &&
             data.squadId.size() >= 1 &&
             data.squadId.size() <= 128 &&
             data.leaderUid is string &&
             data.leaderUid.size() >= 1 &&
             data.leaderUid.size() <= 128 &&
             data.leaderUid == request.auth.uid &&
             data.squadName is string &&
             data.squadName.size() >= 1 &&
             data.squadName.size() <= 40 &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /rivals_squad_codes/{squadCode} {
      allow get: if isSignedIn() && isValidId(squadCode);
      allow list: if isSignedIn() && resource.data.leaderUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(squadCode) &&
                       incoming().keys().hasAll(requiredRivalsSquadCodeKeys()) &&
                       incoming().keys().hasOnly(requiredRivalsSquadCodeKeys()) &&
                       isValidRivalsSquadCode(incoming(), squadCode);

      allow update: if isSignedIn() &&
                       isValidId(squadCode) &&
                       incoming().keys().hasOnly(requiredRivalsSquadCodeKeys()) &&
                       isValidRivalsSquadCode(incoming(), squadCode) &&
                       existing().leaderUid == request.auth.uid &&
                       incoming().leaderUid == existing().leaderUid &&
                       incoming().squadId == existing().squadId &&
                       incoming().squadCode == existing().squadCode &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'squadName',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(squadCode) && existing().leaderUid == request.auth.uid;
    }

    function requiredRivalsSquadInviteKeys() {
      return [
        'inviteId',
        'squadId',
        'squadName',
        'inviterUid',
        'inviterUsername',
        'inviteeUid',
        'inviteeUsername',
        'status',
        'createdAt',
        'updatedAt'
      ];
    }

    function isValidRivalsSquadInvite(data, inviteId) {
      return data.inviteId is string &&
             data.inviteId == inviteId &&
             data.inviteId.size() >= 1 &&
             data.inviteId.size() <= 128 &&
             data.squadId is string &&
             data.squadId.size() >= 1 &&
             data.squadId.size() <= 128 &&
             data.squadName is string &&
             data.squadName.size() >= 1 &&
             data.squadName.size() <= 40 &&
             data.inviterUid is string &&
             data.inviterUid.size() >= 1 &&
             data.inviterUid.size() <= 128 &&
             data.inviterUsername is string &&
             data.inviterUsername.size() >= 1 &&
             data.inviterUsername.size() <= 40 &&
             data.inviteeUid is string &&
             data.inviteeUid.size() >= 1 &&
             data.inviteeUid.size() <= 128 &&
             data.inviteeUid != data.inviterUid &&
             data.inviteeUsername is string &&
             data.inviteeUsername.size() >= 1 &&
             data.inviteeUsername.size() <= 40 &&
             data.status is string &&
             (data.status == 'PENDING' || data.status == 'ACCEPTED' || data.status == 'DECLINED') &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /rivals_squad_invites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (resource.data.inviteeUid == request.auth.uid || resource.data.inviterUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (resource.data.inviteeUid == request.auth.uid || resource.data.inviterUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       incoming().keys().hasAll(requiredRivalsSquadInviteKeys()) &&
                       incoming().keys().hasOnly(requiredRivalsSquadInviteKeys()) &&
                       isValidRivalsSquadInvite(incoming(), inviteId) &&
                       incoming().inviterUid == request.auth.uid &&
                       incoming().status == 'PENDING';

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       incoming().keys().hasOnly(requiredRivalsSquadInviteKeys()) &&
                       isValidRivalsSquadInvite(incoming(), inviteId) &&
                       existing().status == 'PENDING' &&
                       incoming().inviteId == existing().inviteId &&
                       incoming().squadId == existing().squadId &&
                       incoming().inviterUid == existing().inviterUid &&
                       incoming().inviteeUid == existing().inviteeUid &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().inviteeUid == request.auth.uid &&
                          (incoming().status == 'ACCEPTED' || incoming().status == 'DECLINED') &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (existing().inviterUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['squadName', 'status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(inviteId) &&
                       (existing().inviterUid == request.auth.uid || existing().inviteeUid == request.auth.uid);
    }

    function requiredRivalsTauntKeys() {
      return [
        'tauntId',
        'squadId',
        'senderUid',
        'senderName',
        'receiverUid',
        'receiverName',
        'tauntText',
        'passEventKey',
        'createdAt'
      ];
    }

    function isAllowedPresetTauntText(txt) {
      return txt is string &&
             (txt == 'Better luck next time' ||
              txt == 'Catch me if you can' ||
              txt == 'Your too slow' ||
              txt == 'ez' ||
              txt == 'Noobs' ||
              txt == 'GG' ||
              txt == 'Im Just Better');
    }

    function isValidRivalsTaunt(data, tauntId) {
      return data.tauntId is string &&
             data.tauntId == tauntId &&
             data.tauntId.size() >= 1 &&
             data.tauntId.size() <= 128 &&
             data.squadId is string &&
             data.squadId.size() >= 1 &&
             data.squadId.size() <= 128 &&
             data.senderUid is string &&
             data.senderUid.size() >= 1 &&
             data.senderUid.size() <= 128 &&
             data.senderUid == request.auth.uid &&
             data.senderName is string &&
             data.senderName.size() >= 1 &&
             data.senderName.size() <= 60 &&
             data.receiverUid is string &&
             data.receiverUid.size() >= 1 &&
             data.receiverUid.size() <= 128 &&
             data.receiverUid != data.senderUid &&
             data.receiverName is string &&
             data.receiverName.size() >= 1 &&
             data.receiverName.size() <= 60 &&
             isAllowedPresetTauntText(data.tauntText) &&
             data.passEventKey is string &&
             data.passEventKey.size() >= 1 &&
             data.passEventKey.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /rivals_taunts/{tauntId} {
      allow get: if isSignedIn() &&
                    isValidId(tauntId) &&
                    (resource.data.receiverUid == request.auth.uid || resource.data.senderUid == request.auth.uid);

      allow list: if isSignedIn() &&
                     (resource.data.receiverUid == request.auth.uid || resource.data.senderUid == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(tauntId) &&
                       incoming().keys().hasAll(requiredRivalsTauntKeys()) &&
                       incoming().keys().hasOnly(requiredRivalsTauntKeys()) &&
                       isValidRivalsTaunt(incoming(), tauntId);

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidId(tauntId) &&
                       (existing().senderUid == request.auth.uid || existing().receiverUid == request.auth.uid);
    }
  }
}

