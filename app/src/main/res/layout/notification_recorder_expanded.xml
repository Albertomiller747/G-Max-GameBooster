<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Status Row: "Recorder is ready / Tap here to start recording" -->
    <LinearLayout
        android:id="@+id/notif_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#EF5350"
            android:padding="8dp"
            android:src="@android:drawable/presence_video_online"
            android:contentDescription="Recorder status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorder is ready"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap here to start recording"
                android:textColor="#4B5563"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#9CA3AF" />

    <!-- Bottom Action Bar: Record | Videos | Shots | Exit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notif_exp_btn_record"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/notif_exp_icon_record"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_notif_record"
                android:contentDescription="Record" />

            <TextView
                android:id="@+id/notif_exp_txt_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Record"
                android:textColor="#1F2937"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_exp_btn_videos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_notif_videos"
                android:contentDescription="Videos" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Videos"
                android:textColor="#1F2937"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_exp_btn_screenshots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_notif_screenshots"
                android:contentDescription="Screenshots" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Shots"
                android:textColor="#1F2937"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_exp_btn_exit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_notif_exit"
                android:contentDescription="Exit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Exit"
                android:textColor="#1F2937"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
